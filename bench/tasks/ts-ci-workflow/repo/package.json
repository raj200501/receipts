{
  "name": "changelog-lint",
  "version": "0.7.0",
  "description": "Check a CHANGELOG.md against the Keep a Changelog layout.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "changelog-lint": "bin/changelog-lint.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=spec --test-concurrency=1 test/*.test.ts",
    "lint": "node --experimental-strip-types bin/changelog-lint.ts CHANGELOG.md"
  }
}
