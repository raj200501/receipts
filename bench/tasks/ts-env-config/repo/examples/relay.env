# Example environment for running the relay on a laptop (not a real deployment).
# Check it with: npm run envcheck -- --env-file examples/relay.env
RELAY_PORT=9443
RELAY_UPSTREAM_URL=https://hooks.example.invalid/relay/in
# Placeholder value: a real signing secret is provisioned separately.
RELAY_SIGNING_SECRET="example-signing-secret-not-for-production"
RELAY_LOG_LEVEL=debug
RELAY_TIMEOUT=30s
RELAY_RETRY_LIMIT=3
RELAY_ALLOWED_EVENTS=invoice.paid, invoice.voided
RELAY_QUEUE_URL=amqp://localhost:5672/relay-dead-letters
RELAY_VERIFY_TLS=false
