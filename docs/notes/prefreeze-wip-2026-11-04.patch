+    arm = old.rsplit("-", 1)[0]
+    new = next(f"{arm}-{n:03d}" for n in range(4) if f"{arm}-{n:03d}" not in sampled)
+    data["sample"]["sampled_run_ids"] = sorted(sampled - {old} | {new})
