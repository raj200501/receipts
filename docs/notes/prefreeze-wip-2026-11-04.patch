+"""Tests for tools/hook_demo.py (the scripted receipts-hook demo transcript, gate G9)."""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = ROOT / "tools" / "hook_demo.py"
+TRANSCRIPT = ROOT / "artifacts" / "hook" / "demo_transcript.txt"
+
+
+def run_demo() -> str:
+    proc = subprocess.run(
+        [sys.executable, str(SCRIPT)], capture_output=True, text=True, check=True, cwd=ROOT
+    )
+    return proc.stdout
+
+
+def test_output_equals_the_committed_transcript() -> None:
+    assert run_demo() == TRANSCRIPT.read_text(encoding="utf-8")
+
+
+def test_first_line_names_the_generating_script() -> None:
+    first = TRANSCRIPT.read_text(encoding="utf-8").splitlines()[0]
+    found = re.search(r"generated by (\S+)", first)
+    assert found is not None
+    assert found.group(1) == "tools/hook_demo.py"
+    assert (ROOT / found.group(1)).is_file()
+
+
+def test_two_runs_are_identical_and_show_both_stop_events() -> None:
+    first = run_demo()
+    assert first == run_demo()
+    assert "decision: block" in first
+    assert "stop_hook_active: true" in first
+    assert str(ROOT) not in first
+    assert "—" not in first
