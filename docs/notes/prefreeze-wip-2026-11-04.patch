+def quick_analyze(rows: Any, settings: Any = None) -> dict[str, Any]:
+    """A stand-in for results_e4.analyze: the end-to-end tests check the gating only."""
+    return {name: {"model": {"deviation": None}} for name in ("Z1", "Z2", "Z3", "Z4", "Z5")}
