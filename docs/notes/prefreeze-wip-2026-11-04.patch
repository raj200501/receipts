@@ -0,0 +1,186 @@
+"""Print the receipts-hook demo transcript (gate G9), replaying one recorded run offline.
+
+The script feeds one banked smoke-study run (a real local-model run, not synthetic) to the
+real Stop hook, ``python -m receipts.hook stop``, exactly as Claude Code calls it, and prints
+what a person would see: the task, the agent's final report, the hook's decision and the
+message it returns to the agent, and a second Stop event showing that the hook never blocks
+twice in a row. The output is deterministic: no timings, temporary paths, or dates. The
+committed copy is ``artifacts/hook/demo_transcript.txt``; regenerate it with::
+
+    uv run --no-sync python tools/hook_demo.py > artifacts/hook/demo_transcript.txt
+
+The script exits non-zero when the chosen run is missing or the hook does not block it.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import tempfile
+import textwrap
+import tomllib
+from pathlib import Path
+
+from receipts.ledger.events import Ledger
+
+ROOT = Path(__file__).resolve().parents[1]
+RUN_ID = "smoke-pilot-ts-feedsync-ma-qwen7b"
+STUDY = "smoke"
+WIDTH = 88
+
+
+def wrap(text: str, indent: str = "    ") -> str:
+    """Re-wrap ``text`` to a fixed width, keeping paragraphs and "-" list items apart."""
+    out: list[str] = []
+    for para in text.strip().split("\n\n"):
+        items: list[list[str]] = []
+        for line in para.splitlines():
+            if line.lstrip().startswith("-") or not items:
+                items.append([line.strip()])
+            else:
+                items[-1].append(line.strip())
+        for item in items:
+            sub = indent + ("  " if item[0].startswith("-") else "")
+            out.append(
+                textwrap.fill(" ".join(item), WIDTH, initial_indent=indent, subsequent_indent=sub)
+            )
+        out.append("")
+    return "\n".join(out).rstrip("\n")
+
+
+def live_prefix(ledger: Path) -> str:
+    """The ledger as it stood when the agent finished: every line before the first snapshot.
+
+    The harness appends its own post-run snapshot (diff, test rerun, hidden checks) and
+    ``run_end`` after the agent stops. A live Stop hook never sees those, so they are
+    dropped; the hash chain of the remaining prefix stays valid.
+    """
+    kept: list[str] = []
+    for line in ledger.read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        data = json.loads(line).get("data", {})
+        if isinstance(data, dict) and data.get("source") == "snapshot":
+            break
+        kept.append(line)
+    return "\n".join(kept) + "\n"
+
+
+def run_stop_hook(ledger: Path, report: str, active: bool) -> tuple[int, str]:
+    """Call the Stop hook as a fresh process with the documented payload; return (exit, stdout)."""
+    payload = json.dumps(
+        {
+            "hook_event_name": "Stop",
+            "session_id": RUN_ID,
+            "cwd": "/sandbox",
+            "stop_hook_active": active,
+            "last_assistant_message": report,
+        }
+    )
+    with tempfile.TemporaryDirectory() as state:
+        proc = subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "receipts.hook",
+                "stop",
+                "--ledger",
+                str(ledger),
+                "--state",
+                state,
+            ],
+            input=payload,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        if proc.returncode != 0 or (Path(state) / "errors.log").is_file():
+            raise SystemExit(f"stop hook failed (exit {proc.returncode}): {proc.stderr[-500:]}")
+    return proc.returncode, proc.stdout
+
+
+def main() -> int:
+    """Print the transcript."""
+    run_dir = ROOT / "artifacts" / "studies" / STUDY / "runs" / RUN_ID
+    if not (run_dir / "run.json").is_file() or not (run_dir / "ledger.jsonl").is_file():
+        raise SystemExit(f"recorded run {RUN_ID} is missing under {run_dir}")
+    record = json.loads((run_dir / "run.json").read_text(encoding="utf-8"))
+    task_file = ROOT / "bench" / "tasks" / record["task_id"] / "task.toml"
+    task = tomllib.loads(task_file.read_text(encoding="utf-8"))
+    report = str(record["report"])
+
+    with tempfile.TemporaryDirectory() as tmp:
+        live = Path(tmp) / "ledger.jsonl"
+        live.write_text(live_prefix(run_dir / "ledger.jsonl"), encoding="utf-8")
+        Ledger.load(live)
+        code1, out1 = run_stop_hook(live, report, active=False)
+        if not out1.strip():
+            raise SystemExit(
+                f"the hook did not block run {RUN_ID} on the ledger as it stood when the "
+                "agent finished (before the harness snapshot); choose another RUN_ID"
+            )
+        decision = json.loads(out1)
+        if decision.get("decision") != "block":
+            raise SystemExit(f"unexpected hook output for {RUN_ID}: {out1[:200]}")
+        code2, out2 = run_stop_hook(live, report, active=True)
+    if out2.strip():
+        raise SystemExit("the hook blocked a second time")
+
+    rule = "-" * WIDTH
+    lines = [
+        "# receipts-hook demo transcript, generated by tools/hook_demo.py "
+        "(offline replay of a recorded run)",
+        "",
+        f"This replays a recorded run of a local coding model ({record['model']}):",
+        "real data, not synthetic. The run is replayed through the real Stop hook",
+        f"(`python -m receipts.hook stop`). Run id: {RUN_ID}.",
+        "No model is called and no network is used. The hook sees only the session's own",
+        "record (commands, test runs, file edits), with no hidden checks and no test rerun.",
+        "",
+        rule,
+        f"1. The task given to the agent ({record['task_id']})",
+        rule,
+        wrap(str(task["prompt"])),
+        "",
+        rule,
+        "2. The agent works, then writes its final report",
+        rule,
+        "    The ledger is replayed as it stood when the agent finished.",
+        "    Its final report says:",
+        "",
+        wrap(report, "      > "),
+        "",
+        rule,
+        "3. Claude Code fires the Stop event; receipts-hook checks the report",
+        rule,
+        "    stdin: {Stop payload with stop_hook_active: false and last_assistant_message set",
+        "    to the report above}",
+        f"    exit status: {code1}",
+        "    stdout, the decision:",
+        f"      decision: {decision['decision']}",
+        "    stdout, the message Claude sees (reason), exactly as the hook produced it:",
+        "",
+    ]
+    lines.extend(f"      | {line}" for line in str(decision["reason"]).splitlines())
+    lines += [
+        "",
+        "    The session continues, and the agent is asked to correct its report.",
+        "",
+        rule,
+        "4. A second Stop event, after the agent answers (stop_hook_active: true)",
+        rule,
+        "    stdin: {Stop payload with stop_hook_active: true}",
+        f"    exit status: {code2}",
+        "    stdout: (empty)",
+        "",
+        "    Empty output means no decision, so the session ends. The hook never blocks twice",
+        "    in a row, whatever the report says.",
+        "",
+    ]
+    sys.stdout.write("\n".join(lines))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
